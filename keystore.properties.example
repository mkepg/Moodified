# Copy this file to `keystore.properties` and fill in real values.
# `keystore.properties` is gitignored — never commit it.
#
# To generate a release keystore:
#   keytool -genkey -v -keystore moodified-release.jks \
#           -alias moodified -keyalg RSA -keysize 2048 -validity 10000
storeFile=../moodified-release.jks
storePassword=
keyAlias=moodified
keyPassword=

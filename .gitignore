# ---------------------------------------------------------------------------
# Build outputs (regenerated by Gradle on every build)
# ---------------------------------------------------------------------------
.gradle/
/build/
/app/build/
/app/mapping.txt
/captures/
.externalNativeBuild/
.cxx/
.kotlin/

# ---------------------------------------------------------------------------
# Per-machine config (must NOT be committed)
# ---------------------------------------------------------------------------
# Holds the absolute path to the local Android SDK — different on every machine.
/local.properties

# ---------------------------------------------------------------------------
# IDE — ignore caches and workspace state, keep shareable project config
# (gradle.xml, misc.xml, compiler.xml, runConfigurations.xml, etc. are kept)
# ---------------------------------------------------------------------------
/.idea/caches/
/.idea/libraries/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetDropDown.xml
/.idea/shelf/
*.iml

# ---------------------------------------------------------------------------
# OS / tooling junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.repomix

# ---------------------------------------------------------------------------
# Signing
# ---------------------------------------------------------------------------
# NOTE: This is a PRIVATE repository. The release keystore (`*.jks`) and
# `keystore.properties` are intentionally committed so collaborators can
# produce signed release builds with zero additional setup. Do NOT make this
# repository public without first rotating the key and removing both files
# from history.

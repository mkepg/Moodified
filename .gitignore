# ---------------------------------------------------------------------------
# Build outputs (regenerated by Gradle on every build)
# ---------------------------------------------------------------------------
.gradle/
/build/
/app/build/
/app/mapping.txt
/captures/
.externalNativeBuild/
.cxx/
.kotlin/

# ---------------------------------------------------------------------------
# Per-machine config (must NOT be committed)
# ---------------------------------------------------------------------------
# Holds the absolute path to the local Android SDK — different on every machine.
/local.properties

# ---------------------------------------------------------------------------
# IDE — ignore caches and workspace state, keep shareable project config
# (gradle.xml, misc.xml, compiler.xml, runConfigurations.xml, etc. are kept)
# ---------------------------------------------------------------------------
/.idea/caches/
/.idea/libraries/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetDropDown.xml
/.idea/deploymentTargetSelector.xml
/.idea/claudeCodeTabState.xml
/.idea/shelf/
*.iml

# ---------------------------------------------------------------------------
# OS / tooling junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.repomix

# ---------------------------------------------------------------------------
# Local assistant scaffolding. Kept on disk, never committed.
# ---------------------------------------------------------------------------
.superpowers/
docs/superpowers/
CLAUDE.md
AGENTS.md

# ---------------------------------------------------------------------------
# Signing — NEVER commit these. Local-only.
# ---------------------------------------------------------------------------
# The release keystore and its password file must stay off git. The file
# `keystore.properties.example` is a template collaborators can copy locally.
*.jks
keystore.properties

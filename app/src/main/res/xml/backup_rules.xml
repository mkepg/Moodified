<?xml version="1.0" encoding="utf-8"?>
<!--
   Moodified holds sensitive behavioral data (sleep windows, screen-use, mood logs).
   We disable cloud backup by excluding every domain. Used on API < 31; API 31+ uses
   data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>

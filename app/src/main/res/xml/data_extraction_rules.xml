<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ backup/device-transfer rules.
   Moodified excludes all data from cloud backup and device transfer because the
   datastore contains sensitive behavioral inferences (sleep, screen-use, mood).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".KaramayApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Karamay"
        android:windowSoftInputMode="adjustResize">

        <!--
            Disable WorkManager's default initializer so we can supply our own
            Configuration via KaramayApplication.getWorkManagerConfiguration().
            This is required for HiltWorkerFactory to be used by WorkManager.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            SleepReceiver: exported=false, no intent-filter needed.
            Play Services delivers sleep events via an explicit PendingIntent
            targeting this class — no system-level action filter is required.
        -->
        <receiver
            android:name=".data.receiver.sleep.SleepReceiver"
            android:exported="false" />

        <!--
            BootReceiver: must be exported=true so the OS can deliver
            BOOT_COMPLETED and MY_PACKAGE_REPLACED broadcasts.
        -->
        <receiver
            android:name=".data.receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            ActivityReceiver: exported=false, no intent-filter needed.
            Play Services delivers activity-recognition events via an explicit
            PendingIntent — same pattern as SleepReceiver.
        -->
        <receiver
            android:name=".data.receiver.activity.ActivityReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Karamay.SplashScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>
</manifest>